<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>47ac6749-ecc9-4f85-a528-ee5277ebdeb9</UserSecretsId>
	</PropertyGroup>

	<ItemGroup Label="OpenAPI / Swagger">
		<!-- Genera el documento OpenAPI nativo en /openapi/v1.json -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
		<!-- Solo se usa como UI (renderiza el JSON nativo) -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
	</ItemGroup>

	<ItemGroup Label="Entity Framework">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Label="Referencias de proyecto">
		<ProjectReference Include="..\IcfesApp.Application\IcfesApp.Application.csproj" />
		<ProjectReference Include="..\IcfesApp.Infrastructure\IcfesApp.Infrastructure.csproj" />
	</ItemGroup>

	<!-- 👇 Bloque necesario para que el Seeder lea las preguntas del JSON 👇 -->
	<ItemGroup Label="Archivos Estáticos">
		<Content Update="preguntas_icfes.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>